# Copy this file to .env and fill in real values. Never commit .env (it is
# already git-ignored). setup_creds.py writes/updates POLY_API_KEY,
# POLY_API_SECRET and POLY_API_PASSPHRASE in .env for you (chmod 600).

# Wallet private key (0x...) used to sign/derive Polymarket CLOB API creds
# and (in live mode) to authenticate order placement. NEVER share or commit
# this value.
POLY_PRIVATE_KEY=0xyour_wallet_private_key_here

# Derived L2 CLOB API credentials (see setup_creds.py). Leave blank until
# you run `python setup_creds.py --write-env`.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Optional funder/proxy wallet address (Polymarket proxy/smart wallets).
# Leave blank if you trade directly from an EOA.
POLY_FUNDER_ADDRESS=

# Signature type passed to ClobClient (1 = email/magic-link proxy wallet,
# 2 = browser wallet proxy, 0 = plain EOA). Default: 1.
POLY_SIGNATURE_TYPE=1

# Starting bankroll in USDC used for sizing calculations and backtests.
STARTING_BANKROLL=1.0

# Minimum bet size in USDC (also used as the floor when a mode's sizing
# formula would otherwise produce a smaller stake).
MIN_BET=1.0

# Default trading mode: safe | aggressive | degen. Can be overridden with
# `bot.py --mode`.
BOT_MODE=safe
